# ─────────────────────────────────────────────
#  AI Multi-Agent Candidate Evaluation System
#  Environment Configuration Template
# ─────────────────────────────────────────────

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model identifiers
GROQ_MODEL_AGENTS=qwen/qwen3.8-27b
GROQ_MODEL_JUDGE=qwen/qwen3.8-27b

# Sarvam AI TTS (Optional for Voice Debate) — get yours at https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/evaluations.db

# Upload settings
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=20

# Logging
LOG_LEVEL=INFO
