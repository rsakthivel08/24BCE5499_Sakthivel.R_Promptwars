# ─────────────────────────────────────────────
#  AI Multi-Agent Candidate Evaluation System
#  Environment Configuration
# ─────────────────────────────────────────────

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model identifiers
GROQ_MODEL_AGENTS=llama-3.3-70b-versatile
GROQ_MODEL_JUDGE=llama-3.3-70b-versatile

# Sarvam AI TTS — get yours at https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/evaluations.db

# Upload settings
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=20

# Logging
LOG_LEVEL=INFO
